    <defaultLabelColor>(0.9, 0.7, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <everCurableByItem>false</everCurableByItem>
    <stages>
      <li>
        <statFactors>
          <WorkSpeedGlobal>0.85</WorkSpeedGlobal>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

</Defs>
